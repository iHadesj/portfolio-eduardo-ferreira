/**
 * Bakes the static hero poster from the same curve the WebGL ribbon uses, so
 * the LCP image and the live sculpture share one silhouette.
 *
 *   node --experimental-strip-types scripts/generate-hero-poster.mts
 *
 * (Excluded from tsconfig: Node needs the explicit `.ts` import below.)
 *
 * Writes src/components/three/hero-poster-shape.ts. Re-run after changing
 * anything in infinity-path.ts or the resting pose below.
 */
import { writeFileSync } from "node:fs";
import {
  createRibbonFrames,
  ribbonPoint,
  ribbonWidth,
  type Vec3,
} from "../src/components/three/infinity-path.ts";

/** Resting pose: group rotation, group scale and the sculpture's t = 0 sway. */
const GROUP_ROTATION: Vec3 = [0.58, -0.44, -0.1];
const GROUP_SCALE = 0.96;
const GROUP_OFFSET_X = 0.24;
const SCULPTURE_ROTATION: Vec3 = [0, 0.19, 0.053];
const CAMERA_Z = 4.45;
const HALF_FOV_TAN = Math.tan((42 / 2) * (Math.PI / 180));
/** The poster's viewBox is 320 units square, centred on (180, 180). */
const VIEW_HALF = 160;
const VIEW_CENTER = 180;
const SEGMENTS = 96;

function rotateXYZ([x, y, z]: Vec3, [ax, ay, az]: Vec3): Vec3 {
  // three.js Euler order "XYZ": v' = Rx · Ry · Rz · v
  let cx = Math.cos(az),
    sx = Math.sin(az);
  [x, y] = [x * cx - y * sx, x * sx + y * cx];
  cx = Math.cos(ay);
  sx = Math.sin(ay);
  [x, z] = [x * cx + z * sx, -x * sx + z * cx];
  cx = Math.cos(ax);
  sx = Math.sin(ax);
  [y, z] = [y * cx - z * sx, y * sx + z * cx];
  return [x, y, z];
}

function toWorld(point: Vec3): Vec3 {
  const local = rotateXYZ(point, SCULPTURE_ROTATION);
  const scaled: Vec3 = [
    local[0] * GROUP_SCALE,
    local[1] * GROUP_SCALE,
    local[2] * GROUP_SCALE,
  ];
  const world = rotateXYZ(scaled, GROUP_ROTATION);
  return [world[0] + GROUP_OFFSET_X, world[1], world[2]];
}

function project([x, y, z]: Vec3): [number, number] {
  const depth = CAMERA_Z - z;
  return [
    VIEW_CENTER + (x / depth / HALF_FOV_TAN) * VIEW_HALF,
    VIEW_CENTER - (y / depth / HALF_FOV_TAN) * VIEW_HALF,
  ];
}

const normalize = (v: Vec3): Vec3 => {
  const l = Math.hypot(...v) || 1;
  return [v[0] / l, v[1] / l, v[2] / l];
};
const dot = (a: Vec3, b: Vec3) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];

const frames = createRibbonFrames(SEGMENTS);
const light = normalize([-0.45, 0.75, 0.55]);
const rim = normalize([0.8, -0.2, 0.4]);
const quads: number[][] = [];

for (let index = 0; index < SEGMENTS; index += 1) {
  const a = frames[index]!;
  const b = frames[(index + 1) % SEGMENTS]!;
  // Crossing the seam, the next frame's width points the other way.
  const flip = index === SEGMENTS - 1 ? -1 : 1;
  const wa = ribbonWidth(a.u);
  const wb = ribbonWidth(b.u) * flip;
  const corners = [
    toWorld(ribbonPoint(a, -wa, 0)),
    toWorld(ribbonPoint(a, wa, 0)),
    toWorld(ribbonPoint(b, wb, 0)),
    toWorld(ribbonPoint(b, -wb, 0)),
  ];
  const centre: Vec3 = [
    (corners[0]![0] + corners[2]![0]) / 2,
    (corners[0]![1] + corners[2]![1]) / 2,
    (corners[0]![2] + corners[2]![2]) / 2,
  ];
  const view = normalize([-centre[0], -centre[1], CAMERA_Z - centre[2]]);
  let normal = normalize(
    toWorld(a.depth).map((v, k) => v - [GROUP_OFFSET_X, 0, 0][k]!) as Vec3,
  );
  if (dot(normal, view) < 0) normal = [-normal[0], -normal[1], -normal[2]];
  const facing = Math.max(0, dot(normal, view));
  const fresnel = Math.pow(1 - facing, 1.6);
  const diffuse = Math.max(0, dot(normal, light));
  const reflectDir = (l: Vec3): Vec3 => {
    const d = 2 * dot(normal, l);
    return [normal[0] * d - l[0], normal[1] * d - l[1], normal[2] * d - l[2]];
  };
  const specular = Math.pow(Math.max(0, dot(reflectDir(light), view)), 14);
  const rimLight = Math.pow(Math.max(0, dot(reflectDir(rim), view)), 8);

  const reflection = Math.round(Math.min(72, 14 + fresnel * 55 + diffuse * 18));
  const gold = Math.round(Math.min(80, specular * 85 + rimLight * 35));
  // Edges nearer the camera burn brighter.
  const edge = Math.round(
    Math.min(100, 30 + Math.max(0, centre[2] + 0.6) * 45 + gold * 0.4),
  );
  const points = corners.flatMap((corner) =>
    project(corner).map((v) => Math.round(v * 10) / 10),
  );
  quads.push([centre[2], reflection, gold, edge, ...points]);
}

quads.sort((p, q) => p[0]! - q[0]!);
const rows = quads.map(([, ...rest]) => `  [${rest.join(", ")}],`).join("\n");

writeFileSync(
  new URL("../src/components/three/hero-poster-shape.ts", import.meta.url),
  `// Generated by scripts/generate-hero-poster.mts — do not edit by hand.
// Each row, back to front: [reflection %, gold %, edge %, x1, y1, … x4, y4].
// Corners 1→2 and 3→4 run across the ribbon; 2→3 and 4→1 are its two edges.

export const POSTER_QUADS: readonly (readonly number[])[] = [
${rows}
];
`,
);
process.stdout.write(`wrote ${quads.length} quads\n`);
